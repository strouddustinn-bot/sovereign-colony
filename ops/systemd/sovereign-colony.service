[Unit]
Description=Sovereign Colony — advance one mediated colony day
After=docker.service ollama.service

[Service]
Type=oneshot
ExecStart=/home/dstroud/Projects/sovereign-colony/scripts/run_hourly_turn.sh
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/dstroud/Projects/sovereign-colony
ReadWritePaths=/home/dstroud/.local/state/sovereign-colony
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
